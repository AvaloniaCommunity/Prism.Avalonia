<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="SampleDialogApp.Views.MainWindow"
        Title="{Binding Title}"
        Width="550"
        Height="350"
        d:DesignHeight="350"
        d:DesignWidth="550"
        mc:Ignorable="d">
    <Panel>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="5">
            <Label Content="Click to show a dialog window" />
            <Button Content="Simple MessageBox Dialog" Command="{Binding CmdShowMsgBox}" />
            <Button Content="Custom Modal Dialog" Command="{Binding CmdShowDialog}" />
            <Button Content="Non-Modal Dialog (Without Parent)" Command="{Binding CmdShowRegular}" />

            <StackPanel Orientation="Horizontal">
                <Label Content="Result:" />
                <Label Content="{Binding ReturnedResult}" />
            </StackPanel>

        </StackPanel>
    </Panel>
</Window>
